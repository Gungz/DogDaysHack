# DogeVault Stylist environment variables.
# Copy this file to .env and fill in real values. Never commit .env.

# AI reasoning layer
GEMINI_API_KEY=

# YouCam Perfect Corp API
YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com

# Apify MCP e-commerce scraping tool
APIFY_TOKEN=
APIFY_MCP_URL=https://mcp.apify.com/?tools=fetch-actor-details,apify/e-commerce-scraping-tool

# ElevenLabs voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_DOGE_VAULT_PROGRAM_ID=
NEXT_PUBLIC_SOLANA_USDC_MINT=
NEXT_PUBLIC_TREASURY_WALLET_ADDRESS=

# Supabase for image storage + NFT metadata
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_IMAGES_BUCKET=dogevault-images
SUPABASE_METADATA_BUCKET=dogevault-metadata
# Metaplex cNFT (Bubblegum V2) — create tree + Core collection via:
#   npx @metaplex-foundation/cli bg collection create --name "DogeVault" --uri <url> --cluster devnet --rpc-url <rpc> --keypair <path>
#   npx @metaplex-foundation/cli bg tree create --maxDepth 14 --maxBufferSize 64 --canopyDepth 8 --name dogevault --cluster devnet --rpc-url <rpc> --keypair <path>
NEXT_PUBLIC_BUBBLEGUM_TREE=
NEXT_PUBLIC_CORE_COLLECTION=
# Keypair (tree creator) used by the server to mint the receipt cNFT. Reuse your devnet wallet.
MINTER_KEYPAIR_PATH=

DASHSCOPE_API_KEY=
QWEN_IMAGE_MODEL=qwen-image-3.0-pro
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation